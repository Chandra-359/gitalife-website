# ============================================================
# Gita Life NYC — Environment Variables
#
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# ============================================================

# Mapbox — Get your free token at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# PostgreSQL — Connection string for Prisma (from Vercel Postgres dashboard)
# This matches the variable name Vercel creates automatically.
gitalife_PRISMA_DATABASE_URL=

# NextAuth.js — Authentication
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Admin credentials (single admin account)
ADMIN_EMAIL=admin@gitalife.nyc
ADMIN_PASSWORD=

# Google Sheets — logs each confirmed Bhajan Clubbing registration as a
# row in the shared tracking spreadsheet. Leave blank to skip logging
# (the database stays the source of truth either way).
#   1. In Google Cloud Console → IAM & Admin → Service Accounts, create
#      a service account and download a JSON key. Enable the "Google
#      Sheets API" for the project (APIs & Services → Library).
#   2. Share the spreadsheet with the service account's email address
#      (Editor access).
#   3. Fill in from the JSON key file:
#        GOOGLE_SERVICE_ACCOUNT_EMAIL = "client_email"
#        GOOGLE_SERVICE_ACCOUNT_KEY   = "private_key" (paste as-is,
#                                       \n escapes are handled)
# GOOGLE_SHEETS_ID is optional — defaults to the registrations sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SHEETS_ID=

# Square — card payments for the Bhajan Clubbing VIP seva pass
# Get credentials at https://developer.squareup.com/apps
# Leave blank to fall back to pay-at-the-door.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "production" (default) or "sandbox" for testing
SQUARE_ENVIRONMENT=production

# Weekly programs (see /programs) — extra configuration
#
# Weekly-program mail (welcome + reminders) is sent from
# "Gita Life NYC <no-reply@gitalifenyc.com>" via the SMTP settings below.
# Make sure gitalifenyc.com is verified with your SMTP provider so the
# no-reply From address is accepted (Resend: add + verify the domain).
#
# CRON_SECRET protects /api/cron/reminders (the day-before weekly
# reminder sender, scheduled in vercel.json). Set any random string —
# Vercel Cron automatically sends it as "Authorization: Bearer <value>".
CRON_SECRET=

# Vercel Blob — poster/photo/video uploads from the /admin/weekly
# console. Create a Blob store in Vercel → Storage; the token is added
# automatically on Vercel. Without it, admins paste URLs instead.
BLOB_READ_WRITE_TOKEN=

# Optional: a dedicated spreadsheet for weekly-program registrations
# (door check-in). Defaults to GOOGLE_SHEETS_ID / the shared sheet.
# Share it with the service account (Editor), same as above.
GOOGLE_SHEETS_PROGRAMS_ID=

# Optional: absolute site origin used in email links (unsubscribe,
# program page). Defaults to https://www.gitalifenyc.com.
NEXT_PUBLIC_SITE_URL=

# Domain email (SMTP) — registration confirmation emails
# Leave blank to skip sending emails.
#
# Recommended: Resend (free 3,000 emails/mo) + your GoDaddy domain.
#   1. Sign up at https://resend.com and add your domain
#   2. Add the DNS records Resend shows you (DKIM/SPF TXT + MX) in
#      GoDaddy → Domain → DNS, then click Verify in Resend
#   3. Create an API key and fill in:
#        SMTP_HOST=smtp.resend.com
#        SMTP_PORT=465
#        SMTP_USER=resend
#        SMTP_PASS=re_xxxxxxxx        (the API key)
#        SMTP_FROM="Gita Life NYC <hello@yourdomain.com>"
#   The From address must be on the domain you verified in step 2 —
#   Resend rejects every send from an unverified domain (check
#   https://resend.com/domains shows the domain as Verified). Test the
#   live config any time: log in at /admin, then open
#   /api/admin/email-test?to=you@example.com
#
# Any other SMTP host (cPanel, Zoho paid, Workspace, …) works too.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gita Life NYC <hello@gitalifenyc.com>"
# Optional: where replies go (Resend addresses are send-only, so point
# replies at a real inbox you actually read)
SMTP_REPLY_TO=
