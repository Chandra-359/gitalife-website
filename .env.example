# ============================================================
# Gita Life NYC — Environment Variables
#
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# ============================================================

# Mapbox — Get your free token at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# PostgreSQL — Connection string for Prisma (from Vercel Postgres dashboard)
# This matches the variable name Vercel creates automatically.
gitalife_PRISMA_DATABASE_URL=

# NextAuth.js — Authentication
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Admin credentials (single admin account)
ADMIN_EMAIL=admin@gitalife.nyc
ADMIN_PASSWORD=
