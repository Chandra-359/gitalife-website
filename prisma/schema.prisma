// ============================================================
// Gita Life NYC — Prisma Schema
//
// Database: PostgreSQL
// To apply changes:
//   npx prisma migrate dev --name <migration_name>
//   npx prisma generate
//
// To seed the database with mock data:
//   npx prisma db seed
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// A Gita Life NYC program that runs weekly on a specific day.
model Program {
  id          String   @id @default(cuid())
  title       String
  category    String   // e.g. "Kirtan & Prasadam", "Retreat", "Wisdom Session", "Youth Festival"
  description String
  latitude    Float
  longitude   Float
  dayOfWeek   String   @default("Saturday") // e.g. "Saturday", "Sunday", "Wednesday"
  time        String?  // e.g. "6:00 PM", "10:00 AM - 12:00 PM"
  imageUrl    String?  // nullable — optional program hero photo URL

  // --- Event type ---
  type        String   @default("program") // "program" | "volunteer"

  // --- Detail view fields ---
  subtitle        String?    // One-line hook, e.g. "Connecting through sacred sound"
  address         String?    // Full address, e.g. "Hamilton Park, Jersey City, NJ 07302"
  venueName       String?    // Friendly venue name, e.g. "Tompkins Square Park Pavilion"
  duration        String?    // e.g. "2 hours", "Full weekend"
  level           String?    // e.g. "Beginner-friendly", "All levels"

  // --- Capacity & RSVP ---
  capacity        Int?       // null = unlimited spots

  whatToExpect     String[]   // Bullet points: ["Live kirtan", "Prasadam", ...]
  whyAttend       String?    // 1-2 sentence compelling paragraph
  whatYouGet       String[]   // Value props: ["Inner peace", "New friendships", ...]
  whatToBring      String?    // e.g. "Just yourself!" or "Yoga mat & water bottle"

  lectureTopic    String?    // e.g. "The Art of Detachment"
  gitaReference   String?    // e.g. "Chapter 2, Verses 47-51"

  speakerName     String?
  speakerTitle    String?    // e.g. "Monk & Educator"
  speakerBio      String?
  speakerImageUrl String?

  galleryUrls     String[]   // URLs for 2-3 past event photos
  videoUrl        String?    // YouTube/Vimeo embed URL for promo video

  testimonial       String?  // Short quote from a past attendee
  testimonialAuthor String?  // e.g. "Priya, first-time attendee"

  // --- Status & visibility ---
  status      String   @default("published") // "draft" | "published" | "cancelled"
  featured    Boolean  @default(false)        // Pin to top of list

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rsvps       Rsvp[]

  @@index([dayOfWeek])
  @@index([type])
  @@index([status])
}

/// An RSVP submission for a program.
model Rsvp {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String
  guests    Int      @default(1)             // Total attendees including the person
  notes     String?                          // Dietary restrictions, accessibility needs, etc.
  hearAbout String?                          // "How did you hear about this event?" (optional)
  emailOptIn Boolean @default(false)         // Agreed to receive event/program updates by email
  status    String   @default("confirmed")   // "confirmed" | "cancelled" | "waitlisted"

  // --- Weekly reminder emails (weekly programs only) ---
  remindersEnabled Boolean   @default(true)  // Receives the weekly program reminder
  remindersOptOutAt DateTime?                // When the person unsubscribed
  lastReminderAt   DateTime?                 // Last reminder actually sent (dedupe guard)

  checkedInAt DateTime?                      // Set when the party is checked in at the door
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String
  createdAt DateTime @default(now())

  @@unique([email, programId]) // Prevent duplicate RSVPs per event
  @@index([programId])
}
