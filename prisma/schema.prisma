// ============================================================
// Gita Life NYC — Prisma Schema
//
// Database: PostgreSQL
// To apply changes:
//   npx prisma migrate dev --name <migration_name>
//   npx prisma generate
//
// To seed the database with mock data:
//   npx prisma db seed
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// A Gita Life NYC program / event that appears as a pin on the map.
model Program {
  id          String   @id @default(cuid())
  title       String
  category    String   // e.g. "Kirtan & Prasadam", "Retreat", "Wisdom Session", "Youth Festival"
  description String
  latitude    Float
  longitude   Float
  date        DateTime
  imageUrl    String?  // nullable — optional program hero photo URL

  // --- Detail view fields ---
  subtitle        String?    // One-line hook, e.g. "Connecting through sacred sound"
  address         String?    // Full address, e.g. "Hamilton Park, Jersey City, NJ 07302"
  duration        String?    // e.g. "2 hours", "Full weekend"
  level           String?    // e.g. "Beginner-friendly", "All levels"

  whatToExpect     String[]   // Bullet points: ["Live kirtan", "Prasadam", ...]
  whyAttend       String?    // 1-2 sentence compelling paragraph
  whatYouGet       String[]   // Value props: ["Inner peace", "New friendships", ...]
  whatToBring      String?    // e.g. "Just yourself!" or "Yoga mat & water bottle"

  lectureTopic    String?    // e.g. "The Art of Detachment"
  gitaReference   String?    // e.g. "Chapter 2, Verses 47-51"

  speakerName     String?
  speakerTitle    String?    // e.g. "Monk & Educator"
  speakerBio      String?
  speakerImageUrl String?

  galleryUrls     String[]   // URLs for 2-3 past event photos

  testimonial       String?  // Short quote from a past attendee
  testimonialAuthor String?  // e.g. "Priya, first-time attendee"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rsvps       Rsvp[]
}

/// An RSVP submission for a program.
model Rsvp {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String
  program   Program  @relation(fields: [programId], references: [id])
  programId String
  createdAt DateTime @default(now())
}
